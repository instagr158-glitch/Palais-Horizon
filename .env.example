# ---------------------------------------------------------------------------
# Palais Horizon — environment variables
# Copy this file to ".env" and fill in the values. ".env" is git-ignored.
# The app runs without Stripe keys (checkout button shows "payment not configured").
# For deployment see DEPLOY.md.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Local dev and production both use a Postgres URL (set the prod one in Vercel).
#   Easiest : Prisma Postgres  -> prisma+postgres://...  (works for app + migrations)
#   Neon    : use the DIRECT url (no "-pooler"); if pooled, append ?pgbouncer=true
#   Throwaway local: `npx prisma dev` prints a URL to paste here
DATABASE_URL="postgres://user:pass@host:5432/palais_horizon"

# --- App URL / auth ------------------------------------------------------
# Local: http://localhost:3001   Prod: https://your-domain.com
APP_URL="http://localhost:3001"
NEXTAUTH_URL="http://localhost:3001"
# generate with:  openssl rand -base64 32   (use a DIFFERENT value in production)
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- Stripe ------------------------------------------------------------
# TEST keys locally (sk_test_ / pk_test_ / whsec_), LIVE keys in Vercel only.
# 1. dashboard.stripe.com  (account country = France)
# 2. Developers > API keys                -> STRIPE_SECRET_KEY / PUBLISHABLE_KEY
# 3. Product catalog > add product "Palais Horizon Membership"
#      recurring price  EUR 19.00 / month  -> STRIPE_PRICE_MONTHLY (price_...)
#    (the pricing page shows "€19 / month" — keep it in sync)
# 4. Settings > Billing > Customer portal  -> Activate
# 5. Local webhooks:  stripe listen --forward-to localhost:3001/api/webhooks/stripe
#    Prod webhooks:   Developers > Webhooks > add https://your-domain/api/webhooks/stripe
#      events: checkout.session.completed, customer.subscription.updated/deleted
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
# Optional — add a yearly recurring price to also show an annual plan (€190 / year).
STRIPE_PRICE_ANNUAL=""

# --- Ingestion refresh -------------------------------------------------
# CRON_SECRET is sent automatically by Vercel Cron to /api/ingest.
# INGEST_SECRET lets you trigger it manually (curl -H "Authorization: Bearer ...").
CRON_SECRET="change-me-random"
INGEST_SECRET="change-me-random"
